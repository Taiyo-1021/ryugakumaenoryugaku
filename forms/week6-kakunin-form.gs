// Week6 確認テストのフォーム（Part1 和文英訳24問）と回答シートを作る。
// Part3② はリピート（録画をSlackで提出）になったので、フォームには入れない。
// 使い方：script.google.com で新しいプロジェクトを作り、この中身を貼り付けて createWeek6Form を実行する。
// 実行後、「実行ログ」にフォームのURL（生徒用）と回答シートのIDが出る。

const PART1 = [
  'もし明日晴れたら、公園に行きます。',
  'もし時間があれば、あなたに電話します。',
  'もし疲れていたら、早く寝るつもりです。',
  '雨が降ったら、家にいてください。',
  'もしお腹がすいていたら、何か食べてもいいよ。',
  'もし彼が来なかったら、私たちは先に始めます。',
  'もし明日雨なら、何をしますか？',
  '家に着いたら、メッセージを送ります。',
  'もし私がお金持ちなら、大きな家を買うでしょう。',
  'もしもっと時間があれば、毎日運動するでしょう。',
  'もし車を持っていたら、海に行けるのに。',
  'もし私があなたなら、彼に謝るでしょう。',
  'もし英語を上手に話せたら、海外で働くでしょう。',
  'もし宝くじに当たったら、何をしますか？',
  'もし今日が休みなら、一日中寝ているでしょう。',
  'もし彼が忙しくなければ、手伝ってくれるでしょう。',
  'もし一つだけ願いがかなうなら、何を願いますか？',
  'もしもっと勇気があれば、彼女に話しかけるかもしれません。',
  'もし犬を飼っていたら、毎朝散歩に連れて行くでしょう。',
  'もし過去に戻れたら、もっと勉強するでしょう。',
  'もし今晴れていたら、泳ぎに行くのに（実際は雨です）。',
  '私は英語を勉強しています。なぜなら、海外で働きたいからです。',
  'もし明日ひまなら、一緒に映画を見ませんか？',
  'もし私が先生なら、宿題を出さないでしょう。'
];


function createWeek6Form() {
  const form = FormApp.create('Week6 確認テスト｜Part1 和文英訳');
  form.setDescription(
    'Week6 確認テストの Part1（和文英訳）の解答フォームです。\n' +
    'わからない問題も調べずに、自分の知識の範囲内で英文を組み立てましょう。');
  form.setCollectEmail(false);
  form.setShowLinkToRespondAgain(false);

  form.addTextItem()
    .setTitle('お名前（漢字・フルネーム）')
    .setHelpText('毎週同じ書き方で入力してください（例：山田花子）。')
    .setRequired(true);

  form.addPageBreakItem()
    .setTitle('PART1｜文法チェック（和文英訳）')
    .setHelpText('次の日本語を英語にしてください。1問ずつ、思いついた表現で大丈夫です。わからない場合も、書けるところまで書いてください。');
  PART1.forEach(function (jp, i) {
    form.addTextItem().setTitle('Q' + (i + 1) + '. ' + jp);
  });

  // 回答シート（名前に「確認テスト」を含むことが、添削ツールで読み込む条件）
  const ss = SpreadsheetApp.create('Week6 確認テスト｜Part1 和文英訳（回答）');
  form.setDestination(FormApp.DestinationType.SPREADSHEET, ss.getId());

  // フォームと回答シートはマイドライブに置いたままにする。
  // 生徒が見る教材フォルダ（リンクを知っている人は閲覧可）に入れると、全員の名前と回答が見えてしまうため

  Logger.log('生徒用フォームURL：' + form.getPublishedUrl());
  Logger.log('フォーム編集URL：' + form.getEditUrl());
  Logger.log('回答シートID：' + ss.getId());
}
