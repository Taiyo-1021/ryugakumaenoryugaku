// Week3 確認テストのフォーム（Part1 和文英訳24問）と回答シートを作る。
// Part3② はリピート（録画をSlackで提出）になったので、フォームには入れない。
// 使い方：script.google.com で新しいプロジェクトを作り、この中身を貼り付けて createWeek3Form を実行する。
// 実行後、「実行ログ」にフォームのURL（生徒用）と回答シートのIDが出る。

const PART1 = [
  '私はふだん自転車で通勤しています。',
  '母は毎週日曜日に教会に行きます。',
  '最近、私は毎晩英語のポッドキャストを聞いています。',
  '今、雨が強く降っています。',
  '私は彼の名前を知りません。',
  '私は昨日、新しい靴を買いました。',
  '彼女は昨夜、パーティーに来ませんでした。',
  'あなたは週末、どこに行きましたか？',
  '昨日はとても寒かったです。',
  '昨夜10時、私は宿題をしていました。',
  '明日の夜、私は友達と夕食を食べることになっています。',
  '来年、私は海外で働くつもりです。',
  '（荷物を見て）重そうだね。私が持つよ。',
  'あの空を見て。雪が降りそうだ。',
  '最終バスは11時に出ます。',
  '私が駅に着いたとき、電車はちょうど出発するところでした。',
  '料理をしている間に、指を切ってしまいました。',
  '友達から電話があったとき、私はお風呂に入っていました。',
  '明日の今ごろ、私は試験を受けているでしょう。',
  '私は以前、毎朝コーヒーを飲んでいました（今は飲みません）。',
  '子どもの頃は辛い食べ物が食べられませんでしたが、今は食べられます。',
  '最初は緊張しましたが、なんとか発表を最後までやり終えることができました。',
  '昨日、私は遅くまで働かなければなりませんでした。',
  'タクシーに乗るつもりでしたが、歩くことにしました。'
];


function createWeek3Form() {
  const form = FormApp.create('Week3 確認テスト｜Part1 和文英訳');
  form.setDescription(
    'Week3 確認テストの Part1（和文英訳）の解答フォームです。\n' +
    'わからない問題も調べずに、自分の知識の範囲内で英文を組み立てましょう。');
  form.setCollectEmail(false);
  form.setShowLinkToRespondAgain(false);

  form.addTextItem()
    .setTitle('お名前（漢字・フルネーム）')
    .setHelpText('毎週同じ書き方で入力してください（例：山田花子）。')
    .setRequired(true);

  form.addPageBreakItem()
    .setTitle('PART1｜文法チェック（和文英訳）')
    .setHelpText('次の日本語を英語にしてください。1問ずつ、思いついた表現で大丈夫です。わからない場合も、書けるところまで書いてください。');
  PART1.forEach(function (jp, i) {
    form.addTextItem().setTitle('Q' + (i + 1) + '. ' + jp);
  });

  // 回答シート（名前に「確認テスト」を含むことが、添削ツールで読み込む条件）
  const ss = SpreadsheetApp.create('Week3 確認テスト｜Part1 和文英訳（回答）');
  form.setDestination(FormApp.DestinationType.SPREADSHEET, ss.getId());

  // フォームと回答シートはマイドライブに置いたままにする。
  // 生徒が見る教材フォルダ（リンクを知っている人は閲覧可）に入れると、全員の名前と回答が見えてしまうため

  Logger.log('生徒用フォームURL：' + form.getPublishedUrl());
  Logger.log('フォーム編集URL：' + form.getEditUrl());
  Logger.log('回答シートID：' + ss.getId());
}
