// Week7 確認テストのフォーム（Part1 和文英訳24問）と回答シートを作る。
// Part3② はリピート（録画をSlackで提出）になったので、フォームには入れない。
// 使い方：script.google.com で新しいプロジェクトを作り、この中身を貼り付けて createWeek7Form を実行する。
// 実行後、「実行ログ」にフォームのURL（生徒用）と回答シートのIDが出る。

const PART1 = [
  '私はスカイダイビングを一度したことがあります。',
  'あなたは今までに英語でスピーチをしたことがありますか？',
  '私は一度も海外に住んだことがありません。',
  '彼は沖縄を何度か訪れたことがあります。',
  '彼女は買い物に行ってしまいました（今ここにいません）。',
  '私は最近、前より勇敢になりました。',
  '私は去年、初めて一人で旅行しました。',
  '私は3日前に彼女に会いました。',
  'あなたは以前その映画を見たことがありますか？',
  'この橋は100年以上守られてきました。',
  '私は10年間ここに住んでいます。',
  '彼は先月から日記をつけています。',
  'あなたはどのくらいの期間、英語を勉強していますか？',
  '私は子どものころからずっと犬が好きです。',
  '私たちは高校を卒業して以来、会っていません。',
  '私はちょうど昼ご飯を食べ終えたところです。',
  '電車はもう出発してしまいました。',
  'あなたはもうレポートを書き終えましたか？',
  '私はまだ彼のメールに返信していません。',
  '私はスマホをなくしてしまいました（今も見つかっていません）。',
  '今のところ、新しい仕事は順調です。',
  'これは私が今までに見た中で一番美しい景色です。',
  '兄はまだ車の運転を覚えていません。',
  '私は京都に3回行ったことがありますが、大阪には一度も行ったことがありません。'
];


function createWeek7Form() {
  const form = FormApp.create('Week7 確認テスト｜Part1 和文英訳');
  form.setDescription(
    'Week7 確認テストの Part1（和文英訳）の解答フォームです。\n' +
    'わからない問題も調べずに、自分の知識の範囲内で英文を組み立てましょう。');
  form.setCollectEmail(false);
  form.setShowLinkToRespondAgain(false);

  form.addTextItem()
    .setTitle('お名前（漢字・フルネーム）')
    .setHelpText('毎週同じ書き方で入力してください（例：山田花子）。')
    .setRequired(true);

  form.addPageBreakItem()
    .setTitle('PART1｜文法チェック（和文英訳）')
    .setHelpText('次の日本語を英語にしてください。1問ずつ、思いついた表現で大丈夫です。わからない場合も、書けるところまで書いてください。');
  PART1.forEach(function (jp, i) {
    form.addTextItem().setTitle('Q' + (i + 1) + '. ' + jp);
  });

  // 回答シート（名前に「確認テスト」を含むことが、添削ツールで読み込む条件）
  const ss = SpreadsheetApp.create('Week7 確認テスト｜Part1 和文英訳（回答）');
  form.setDestination(FormApp.DestinationType.SPREADSHEET, ss.getId());

  // フォームと回答シートはマイドライブに置いたままにする。
  // 生徒が見る教材フォルダ（リンクを知っている人は閲覧可）に入れると、全員の名前と回答が見えてしまうため

  Logger.log('生徒用フォームURL：' + form.getPublishedUrl());
  Logger.log('フォーム編集URL：' + form.getEditUrl());
  Logger.log('回答シートID：' + ss.getId());
}
